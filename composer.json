{
    "name": "wuwx/filament-currency-field",
    "description": "Filament currency field.",
    "keywords": [
        "filament",
        "laravel",
        "currency"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "filament/forms": "^3.0|^4.0|^5.0",
        "moneyphp/money": "^4.2"
    },
    "require-dev": {
        "livewire/livewire": "^3.5|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wuwx\\FilamentCurrencyField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wuwx\\FilamentCurrencyField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "wuwx",
            "email": "wuweixin@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
